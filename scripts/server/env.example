# Copy this file to scripts/server/.env and edit paths for the server.

# Project root on server. If empty, scripts use current working directory.
export SCENEGRAPHVLM_ROOT="${SCENEGRAPHVLM_ROOT:-$(pwd)}"

# GPU selection.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

# Checkpoint paths.
export CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-$SCENEGRAPHVLM_ROOT/checkpoints}"
export AG_MODEL="${AG_MODEL:-$CHECKPOINT_ROOT/AG}"
export PSG_MODEL="${PSG_MODEL:-$CHECKPOINT_ROOT/PSG}"
export PVSG_MODEL="${PVSG_MODEL:-$CHECKPOINT_ROOT/PVSG}"

# Dataset jsonl paths. Adjust these after dataset preparation.
export DATA_ROOT="${DATA_ROOT:-$SCENEGRAPHVLM_ROOT/datasets}"
export AG_TEST_JSONL="${AG_TEST_JSONL:-$DATA_ROOT/data_playground/AG_json/ag_gt_prompt/test.jsonl}"
export PSG_TEST_JSONL="${PSG_TEST_JSONL:-$DATA_ROOT/data_playground/PSG_json/psg_gt_prompt/test.jsonl}"
export PVSG_TEST_JSONL="${PVSG_TEST_JSONL:-$DATA_ROOT/data_playground/PVSG_json/pvsg_psfr_gt_prompt/test.jsonl}"

# Optional image base for relative image paths in jsonl.
export IMAGES_BASE="${IMAGES_BASE:-}"

# Output roots.
export RESULT_ROOT="${RESULT_ROOT:-$SCENEGRAPHVLM_ROOT/metrics/results/full_reproduction}"
export EVAL_ROOT="${EVAL_ROOT:-$SCENEGRAPHVLM_ROOT/metrics/results/full_reproduction_eval}"

# vLLM settings. Tune by GPU memory.
export BATCH_SIZE="${BATCH_SIZE:-1}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-2048}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-8192}"
export GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.80}"
export TENSOR_PARALLEL_SIZE="${TENSOR_PARALLEL_SIZE:-1}"

# For a small subset test, create a separate jsonl file and set *_TEST_JSONL to it.

